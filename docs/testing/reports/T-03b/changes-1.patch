+@pytest.fixture
+def uat_log_dir(tmp_path) -> Path:
+    where = os.environ.get("SV_UAT_APP_LOG_DIR")
+    path = Path(where) if where else tmp_path
+    path.mkdir(parents=True, exist_ok=True)
+    return path
