+# ============================================================
+# unit level (no marker): the launcher, main(), no hardware
+# ============================================================
+STUB = '#!/bin/bash\nprintf \'%s\\n\' "$@" > "$STUB_ARGS_FILE"\nexit ${STUB_EXIT:-0}\n'
