+    def start(service: str | None = "1", run_sh: str | None = None, tag: str = "", real_ports: bool = False):
+        if real_ports:
+            glasses = panel = None
+            ports = ("/dev/serial0", "/dev/ttyAMA3")        # the launcher's own defaults
+        else:
+            glasses, panel = FakeGlasses(), FakePanel()
