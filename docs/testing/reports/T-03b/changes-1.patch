+def send_mode(app: LauncherRun, panel: FakePanel, mode: str):
+    start = app.index()
+    app.mark(f"panel sends M:{mode}")
+    panel.send(f"M:{mode}")
+    assert app.wait_for(f"[CONFIG] Mode: {mode}", 8, start), f"the panel line was not read:\n{app.text(start)[-1500:]}"
