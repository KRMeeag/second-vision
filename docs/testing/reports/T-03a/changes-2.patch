+        lost = [line for _, line in app.lines[back_from:] if LOSS_SEEN in line]
+        print(f"while held: {len(attempts)} starts on a camera, {len(lost)} losses")
+        assert attempts, "the program never tried the returned camera"
+    finally:
+        holder.stop()
