+class VClock:
+    """A clock that only moves when the test moves it."""
+
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+
+def detection(label="person", zone="left", priority=1.0, tier=TIER_NORMAL):
