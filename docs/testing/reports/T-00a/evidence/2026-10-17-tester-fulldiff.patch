+log = os.open(os.environ["ESPEAK_STUB_LOG"], os.O_WRONLY | os.O_APPEND | os.O_CREAT)
+def rec(ev, **kw):
+    os.write(log, (json.dumps(dict(ev=ev, text=text, t=time.monotonic(), pid=os.getpid(), **kw)) + "\\n").encode())
+def on_term(signum, frame):
