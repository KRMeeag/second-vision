+    rig.alerts.set_repeat("c", False)                       # utterance is under way
+    assert wait_until(lambda: rig.utts("ALERT depth")[0]["outcome"] != "running", 4.0)
+    assert rig.utts("ALERT depth")[0]["outcome"] == "end", "the utterance under way was cut"
