+def test_req_con_03_repeat_off_after_it_was_spoken_is_not_spoken_again(mk):
+    clk = WarpClock()
+    rig = mk(clock=clk).start()
+    rig.alerts.raise_alert("c", "ALERT depth", interval=30.0)
+    assert wait_until(lambda: rig.count("ALERT depth") == 1, 2.0)
